# =============================================================================
# Variáveis do servidor. NENHUMA usa o prefixo NEXT_PUBLIC_, de propósito:
# todo acesso ao Supabase acontece no servidor, então estes valores nunca são
# embutidos no JavaScript enviado ao navegador.
#
# Copie este arquivo para .env.local (que o .gitignore já ignora) e preencha.
# =============================================================================

# Supabase → Project Settings → Data API / API Keys → Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# A "Publishable key" (ou a "anon public key", nos projetos mais antigos).
# NUNCA use aqui a service_role / secret key: ela ignora o Row Level Security.
SUPABASE_ANON_KEY=sua-publishable-key

# Endereço público do app, usado nos links de confirmação de e-mail.
# Em produção, o domínio da Vercel.
SITE_URL=http://localhost:3000
